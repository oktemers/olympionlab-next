# Server-only YouTube Data API v3 key (do NOT add NEXT_PUBLIC_ prefix).
YOUTUBE_API_KEY=

# Configure only playlists meant for FREE / publicly viewable content.
# From URL: https://www.youtube.com/playlist?list=PL...
YOUTUBE_PLAYLIST_REHBERLIK=

# Optional additional FREE video collections.
YOUTUBE_PLAYLIST_FIZIK=
YOUTUBE_PLAYLIST_KIMYA=
YOUTUBE_PLAYLIST_MATEMATIK=
YOUTUBE_PLAYLIST_BIYOLOJI=
YOUTUBE_PLAYLIST_PROJE=
